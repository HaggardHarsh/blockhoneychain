PORT=5000
MONGODB_URI=mongodb://localhost:27017/honeychain
JWT_SECRET=honeychain_jwt_secret_sih2026_change_in_production
JWT_EXPIRY=7d

# AI/LLM - for lab report OCR
OPENROUTER_API_KEY=your_openrouter_api_key

# SMTP Configuration for Emails
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password

# ═══════════════════════════════════════════════
# Blockchain Configuration
# ═══════════════════════════════════════════════
#
# Choose ONE of the two options below:
#
# --- Option A: Polygon Amoy Testnet (recommended for demos) ---
# Get free POL tokens from: https://faucet.polygon.technology/
BLOCKCHAIN_RPC_URL=https://polygon-amoy-bor-rpc.publicnode.com
DEPLOYER_PRIVATE_KEY=your_metamask_private_key
# Contract addresses (filled after deployment - run: npm run deploy:amoy)
BEEKEEPER_REGISTRY_ADDRESS=
HONEY_BATCH_ADDRESS=
QUALITY_CERT_ADDRESS=
#
# --- Option B: Local Hardhat Node (for offline development) ---
# Start local node first: npm run dev:blockchain
# Then deploy:         npm run deploy:contracts
# BLOCKCHAIN_RPC_URL=http://127.0.0.1:8545
# DEPLOYER_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
#
# --- Option C: No Blockchain (MongoDB-only mode) ---
# Simply leave all BLOCKCHAIN_* vars empty or remove them.
# The app will run without on-chain traceability.
# ═══════════════════════════════════════════════

# IPFS (Pinata) - Optional
PINATA_API_KEY=
PINATA_SECRET_KEY=

# Frontend
FRONTEND_URL=http://localhost:3000
