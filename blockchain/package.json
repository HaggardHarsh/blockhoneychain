{
  "name": "honeychain-blockchain",
  "version": "1.0.0",
  "description": "HoneyChain Smart Contracts",
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test",
    "node": "hardhat node",
    "deploy:local": "hardhat run scripts/deploy.js --network localhost",
    "deploy:amoy": "node node_modules/hardhat/internal/cli/cli.js run scripts/deploy-amoy.js --network amoy",
    "deploy:fuji": "node node_modules/hardhat/internal/cli/cli.js run scripts/deploy-fuji.js --network fuji",
    "verify": "hardhat verify --network amoy"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^4.0.0",
    "hardhat": "^2.19.0"
  },
  "dependencies": {
    "@openzeppelin/contracts": "^5.0.0",
    "dotenv": "^17.4.2"
  }
}
